<?xml version="1.0"?>
<!-- Checkpoint 1: base_link (a box) + arm (a cylinder), revolute about y, +-90 deg.
     Plain URDF has no ${radians(90)}, so the limit is written out: 1.5708 rad. -->
<robot name="pendulum">

  <!-- Root link: no <inertial> (KDL warns about an inertial on the root). -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
    </collision>
  </link>

  <!-- The joint origin puts the pivot on top of the box. -->
  <joint name="swing" type="revolute">
    <parent link="base_link"/>
    <child link="arm"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="1.0"/>
  </joint>

  <!-- The visual origin slides the cylinder up its own z, so it hangs from the pivot
       instead of being centred on it. -->
  <link name="arm">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.02" length="0.3"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.02" length="0.3"/></geometry>
    </collision>
    <!-- Solid cylinder, m = 0.2 kg: ixx = iyy = m(3r^2 + l^2)/12, izz = m r^2 / 2 -->
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="0.2"/>
      <inertia ixx="0.00152" ixy="0" ixz="0" iyy="0.00152" iyz="0" izz="0.00004"/>
    </inertial>
  </link>

</robot>

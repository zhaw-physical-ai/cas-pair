<?xml version="1.0"?>
<!-- One SO-101 with a wrist camera, or two side by side.

     xacro so101.urdf.xacro                      | check_urdf /dev/stdin
     xacro so101.urdf.xacro prefix:=left_        | check_urdf /dev/stdin
     xacro so101.urdf.xacro two_arms:=true       | check_urdf /dev/stdin -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="two_arms" default="false"/>

  <xacro:include filename="$(find so101_description)/urdf/so101_macro.xacro"/>
  <xacro:include filename="$(find so101_description)/urdf/wrist_camera.xacro"/>

  <!-- Root: empty, so it has no <inertial>. It stands for the table the arm is clamped to. -->
  <link name="base_link"/>

  <xacro:unless value="$(arg two_arms)">
    <xacro:so101 prefix="$(arg prefix)" parent="base_link">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:so101>
    <xacro:wrist_camera prefix="$(arg prefix)"/>
  </xacro:unless>

  <xacro:if value="$(arg two_arms)">
    <xacro:so101 prefix="left_" parent="base_link">
      <origin xyz="0 0.25 0" rpy="0 0 0"/>
    </xacro:so101>
    <xacro:wrist_camera prefix="left_"/>
    <xacro:so101 prefix="right_" parent="base_link">
      <origin xyz="0 -0.25 0" rpy="0 0 0"/>
    </xacro:so101>
    <xacro:wrist_camera prefix="right_"/>
  </xacro:if>

</robot>

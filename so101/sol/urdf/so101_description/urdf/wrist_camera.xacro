<?xml version="1.0"?>
<!-- Wrist camera: the printed mount and the camera body from upstream so101_new_calib_camera.urdf,
     plus the two frames the lab asks for:
       camera_link           REP-103 body frame: x forward (where the lens looks), y left, z up
       camera_optical_frame  REP-103 optical frame: z forward, x right, y down
     Images are stamped in camera_optical_frame; camera_link is only for mounting. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wrist_camera" params="prefix">

    <!-- Visual parts, pose taken from upstream. -->
    <joint name="${prefix}wrist_camera_mount_joint" type="fixed">
      <parent link="${prefix}gripper_link"/>
      <child link="${prefix}wrist_camera_mount_link"/>
      <origin xyz="-0.0150 0.0240 -0.0315" rpy="-1.5708 -0.0008 -1.5708"/>
    </joint>
    <link name="${prefix}wrist_camera_mount_link">
      <visual>
        <geometry>
          <!-- this STL is in millimetres, the others are in metres -->
          <mesh filename="package://so101_description/meshes/wrist_camera_mount_so101_v1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}3d_printed"/>
      </visual>
      <collision>
        <geometry><box size="0.066 0.043 0.035"/></geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <joint name="${prefix}wrist_camera_joint" type="fixed">
      <parent link="${prefix}wrist_camera_mount_link"/>
      <child link="${prefix}wrist_camera_body_link"/>
      <origin xyz="-0.04941 -0.03813 0.0175" rpy="0 -1.5708 -2.0076"/>
    </joint>
    <link name="${prefix}wrist_camera_body_link">
      <visual>
        <geometry>
          <mesh filename="package://so101_description/meshes/wrist_camera_so101_v1.stl"/>
        </geometry>
        <material name="${prefix}sts3215"/>
      </visual>
      <collision>
        <geometry><box size="0.032 0.032 0.033"/></geometry>
      </collision>
      <inertial>
        <mass value="0.015"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <!-- camera_link: at the camera body's position (computed from the two joints above),
         x pointing along the gripper's approach direction, which is -z of gripper_link.
         Rotating +90 deg about y turns x into -z. -->
    <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${prefix}gripper_link"/>
      <child link="${prefix}camera_link"/>
      <origin xyz="0.0025 0.0734 0.0066" rpy="0 ${radians(90)} 0"/>
    </joint>
    <link name="${prefix}camera_link"/>

    <!-- The standard body -> optical rotation: same for every camera. -->
    <joint name="${prefix}camera_optical_joint" type="fixed">
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${radians(-90)} 0 ${radians(-90)}"/>
    </joint>
    <link name="${prefix}camera_optical_frame"/>

  </xacro:macro>

</robot>
